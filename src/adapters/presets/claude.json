{
  "id": "preset-claude",
  "name": "Anthropic Claude",
  "mode": "medium",
  "api_url": "https://api.anthropic.com/v1",
  "request_method": "POST",
  "request_headers": {
    "x-api-key": "{{api_key}}",
    "anthropic-version": "2023-06-01",
    "Content-Type": "application/json"
  },
  "request_body_template": "{\n  \"model\": \"{{model}}\",\n  \"max_tokens\": {{max_tokens}},\n  \"messages\": {{messages}},\n  \"stream\": true\n}",
  "sse_enabled": true,
  "sse_data_prefix": "data: ",
  "sse_done_marker": "",
  "sse_content_path": "$.delta.text",
  "response_content_path": "$.content[0].text",
  "category": "Official",
  "is_preset": true
}
