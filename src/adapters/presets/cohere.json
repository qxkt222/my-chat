{
  "id": "preset-cohere",
  "name": "Cohere",
  "mode": "simple",
  "api_url": "https://api.cohere.ai",
  "request_method": "POST",
  "request_headers": {
    "Authorization": "Bearer {{api_key}}",
    "Content-Type": "application/json",
    "accept": "application/json"
  },
  "request_body_template": "{\n  \"model\": \"{{model}}\",\n  \"messages\": {{messages}},\n  \"temperature\": {{temperature}},\n  \"stream\": true\n}",
  "sse_enabled": true,
  "sse_data_prefix": "",
  "sse_done_marker": "",
  "sse_content_path": "$.delta.message.content.text",
  "response_content_path": "$.message.content[0].text",
  "pre_script": "",
  "parse_script": "",
  "category": "Official",
  "is_preset": true
}
